# Configuration de l'API NestJS (validée au démarrage : voir src/config/env.ts).
# Copier en .env et remplir. Ne jamais commiter le fichier .env.

NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://scout:scout_password@localhost:5435/scout_db"

# Secret de signature des jetons d'accès (HS256), au moins 32 caractères.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="remplacer-par-un-secret-long-et-aleatoire"
# Durée de vie du jeton d'accès (secondes) : le rôle et le statut actif sont
# relus en base à chaque rafraîchissement.
JWT_ACCESS_TTL_SECONDES=300
# Durée totale d'une session de connexion (secondes).
SESSION_TTL_SECONDES=43200

# Identifiant de cette installation (minuscules, chiffres, tirets), ex.
# « paroisse-wiradjuri » : émetteur de ses jetons.
INSTALLATION_ID="paroisse-locale"

# Origines autorisées à appeler l'API depuis un navigateur avec des cookies
# séparées par des virgules. Laisser vide : le frontend relaie /api côté
# serveur. Toute interconnexion future doit être autorisée séparément.
CORS_ORIGINES=""
# Domaine des cookies de session, pour partager la session entre
# sous-domaines (ex. ".scout-ascci.ci"). Vide = cookie limité à l'hôte.
COOKIE_DOMAINE=""
# URL publique du frontend paroissial (liens des e-mails de réinitialisation).
URL_FRONTEND_PAROISSE="http://localhost:3000"

# Proxys de confiance devant l'API pour lire l'IP réelle du client
# (limitation de débit) : "loopback" quand Nginx et le frontend tournent sur
# la même machine que l'API, sinon un nombre de sauts.
TRUST_PROXY="loopback"
# Documentation interactive sur /api/docs (à laisser à false en production).
SWAGGER_ACTIF=false

# Secret des tâches planifiées (en-tête x-cron-secret), au moins 16 caractères.
# Obligatoire en production, comme SMTP_HOST, SMTP_FROM et une
# URL_FRONTEND_PAROISSE en https : l'API refuse de démarrer sans.
CRON_SECRET="choisissez-un-secret-long-et-aleatoire"

# Durées de conservation, en jours (365 minimum), appliquées chaque nuit par la
# tâche POST /api/cron/purge. Laisser vides tant que l'association ne les a pas
# fixées : rien n'est alors supprimé (loi n° 2013-450, voir docs/deploiement-ovh.md).
#   - RETENTION_AUDIT_JOURS : suppression des entrées du journal d'audit ;
#   - ANONYMISATION_SCOUTS_INACTIFS_JOURS : anonymisation des scouts inactifs
#     (identité, contacts, santé, documents ; IRRÉVERSIBLE).
RETENTION_AUDIT_JOURS=""
ANONYMISATION_SCOUTS_INACTIFS_JOURS=""

# Redis (facultatif) : compteurs de tentatives partagés entre plusieurs
# instances de l'API. Vide = compteurs en mémoire (une seule instance pm2).
REDIS_URL=""

# E-mail (optionnel — sans SMTP_HOST, les liens sont affichés dans la console en développement).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASS="votre-mot-de-passe-smtp"
SMTP_FROM="noreply@scout-ascci.ci"

# --- Stockage des fichiers ---
# PRODUCTION : Cloudflare R2, obligatoire (l'API refuse de démarrer sans) :
# aucun document n'est conservé sur le VPS. Deux buckets distincts :
#   - privé (photos, fiches médicales, autorisations) : AUCUN accès public,
#     servi uniquement par l'API après contrôle des droits ;
#   - public (logos, image d'accueil) : exposé via un domaine personnalisé
#     (ex. fichiers.example.ci) dans R2 > bucket > Settings > Public access.
# Jeton d'API R2 : permission « Object Read & Write » limitée à ces deux buckets.
# STORAGE_S3_BUCKET="scout-prive"
# STORAGE_S3_BUCKET_PUBLIC="scout-public"
# STORAGE_S3_REGION="auto"
# STORAGE_S3_ENDPOINT="https://<ID_DU_COMPTE>.r2.cloudflarestorage.com"
# STORAGE_S3_ACCESS_KEY_ID="..."
# STORAGE_S3_SECRET_ACCESS_KEY="..."
# STORAGE_PUBLIC_URL_BASE="https://fichiers.example.ci"
#
# --- Sauvegardes de la base (production) ---
# Envoyées chiffrées dans un bucket R2 dédié, JAMAIS public (npm run
# sauvegarder : chaque nuit par cron, et avant chaque migration).
# SAUVEGARDE_S3_BUCKET="scout-sauvegardes"
# Phrase secrète de chiffrement (20 caractères minimum). À conserver AUSSI
# hors du VPS (gestionnaire de mots de passe) : sans elle, les sauvegardes
# sont illisibles, y compris après la perte du serveur.
# SAUVEGARDE_PHRASE="..."
# Facultatif : jeton R2 limité au seul bucket des sauvegardes (recommandé).
# Sans ces lignes, les identifiants STORAGE_S3_* ci-dessus sont utilisés.
# SAUVEGARDE_S3_ACCESS_KEY_ID="..."
# SAUVEGARDE_S3_SECRET_ACCESS_KEY="..."
# Conteneur Docker de la base à sauvegarder : scout_db (paroisse, par défaut)
# ou la valeur de CONTENEUR_DB du .env.prod.
# SAUVEGARDE_CONTENEUR="scout_db"
# Adresse prévenue par e-mail (SMTP ci-dessus) quand une sauvegarde échoue.
# SAUVEGARDE_ALERTE_EMAIL="dsi@exemple.ci"

# DÉVELOPPEMENT : sans STORAGE_S3_BUCKET, les fichiers sont écrits sur le
# disque local, dans STORAGE_DOSSIER_LOCAL/uploads-publiques et
# STORAGE_DOSSIER_LOCAL/uploads-prives (dossier courant du process si vide).
STORAGE_DOSSIER_LOCAL=""

# Compte administrateur créé par `npm run db:seed` (développement uniquement).
# ADMIN_NOM="Administrateur"
# ADMIN_PRENOM="Principal"
# ADMIN_MATRICULE="ADMIN001A"
# ADMIN_EMAIL="admin@exemple.ci"
# ADMIN_PASSWORD="choisissez-un-mot-de-passe"
# Jeu de démonstration fictif (un compte par rôle, scouts, contenus) créé par le même seed : SEED_DEMO=false pour l'administrateur seul.
# SEED_DEMO="true"
# SEED_MOT_DE_PASSE="Scout1234!"

