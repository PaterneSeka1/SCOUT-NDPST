{
  "name": "@scout/api",
  "version": "0.1.0",
  "private": true,
  "description": "API SCOUT ASCCI (NestJS) — partagée par la plateforme paroissiale et les futures plateformes district, région et nation.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "prisma:diff": "prisma migrate diff --from-config-datasource --to-schema ./prisma/schema.prisma --script",
    "prisma:status": "prisma migrate status",
    "fichiers:migrer-r2": "ts-node --transpile-only scripts/migrer-fichiers-r2.ts",
    "initialiser": "ts-node --transpile-only scripts/initialiser.ts",
    "sauvegarder": "ts-node --transpile-only scripts/sauvegarder-base.ts",
    "restaurer-sauvegarde": "ts-node --transpile-only scripts/restaurer-sauvegarde.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@scout/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "nodemailer": "10.0.13",
    "papaparse": "^5.5.4",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@swc/core": "^1.13.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9",
    "eslint-config-prettier": "10.1.8",
    "prisma": "^7.8.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
