// Schéma Prisma — SCOUT-NDPST
// Plateforme d'UNE seule paroisse : son identité est une configuration unique
// (ConfigurationInstallation), jamais une entité métier gérée en plusieurs
// exemplaires. Aucune notion de district, de région ni de multi-paroisses.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // NestJS compile les sources TypeScript en JavaScript avant leur exécution.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum BrancheType {
  OISILLONS
  LOUVETEAUX
  ECLAIREURS
  CHEMINOTS
  COMPAGNONS
  RESSOURCES_ADULTES // Catégorie de gestion hors des cinq branches : scouts de 21 ans ou plus non encore chefs d’unité
}

enum RoleUtilisateur {
  ADMINISTRATEUR // Administration technique : comptes, configuration, contenus publics, audit
  CHEF_GROUPE // Direction scoute du groupe
  ADJOINT_GROUPE
  ASSISTANT_GROUPE
  RESPONSABLE_BRANCHE
  ADJOINT_BRANCHE
  ASSISTANT_BRANCHE
  PARENT
  SCOUT
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum TypeActivite {
  REUNION
  SORTIE
  CAMP
  SERVICE
  CELEBRATION
  FORMATION
  AUTRE
}

enum StatutActivite {
  PREVUE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum TypeDocument {
  AUTORISATION_PARENTALE
  CERTIFICAT_MEDICAL
  PHOTO_IDENTITE
  AUTRE
}

enum StatutReunion {
  PLANIFIEE
  REPORTEE
  ANNULEE
  TERMINEE
}

enum StatutPresenceReunion {
  PRESENT
  ABSENT
  EXCUSE
}

enum TypeCotisation {
  ADHESION_ANNUELLE
  CAMP
  AUTRE
}

enum StatutCotisation {
  EN_ATTENTE
  PARTIELLEMENT_PAYEE
  PAYEE
  EXONEREE
}

enum StatutPublication {
  BROUILLON
  PUBLIEE
  ARCHIVEE
}

enum TypeEvenementHistorique {
  ORIGINE
  FONDATION
  CHEF_DE_GROUPE
  CAMP
  ETAPE
  TEMOIGNAGE
  ARCHIVE
}

enum StatutValidationHistorique {
  A_VERIFIER // Fait rapporté, en attente de confirmation par une source
  VALIDE // Confirmé par une source citée
}

enum TypeDemande {
  INSCRIPTION_JEUNE
  ENGAGEMENT_ADULTE
  INFORMATION
}

enum StatutDemande {
  NOUVELLE
  EN_COURS
  ACCEPTEE
  REFUSEE
  ARCHIVEE
}

// ---------------------------------------------------------------------------
// Configuration de l'installation — identité de LA paroisse. Ligne unique
// (id fixe "installation"), créée par la migration ou l'initialisation et
// seulement mise à jour ensuite (Administration > Identité et configuration).
// ---------------------------------------------------------------------------

model ConfigurationInstallation {
  id                   String   @id @default("installation")
  nomParoisse          String   @default("")
  nomGroupe            String   @default("")
  ville                String?
  diocese              String?
  presentation         String?
  messageBienvenue     String?
  // Année d'accueil du scoutisme dans la paroisse (valorisée sur le site public).
  anneeHistorique      Int?
  // Mention historique complémentaire (ex. rang d'arrivée du scoutisme) : affichée
  // publiquement seulement lorsque rangHistoriqueValide est vrai.
  rangHistorique       String?
  rangHistoriqueValide Boolean  @default(false)
  sourceHistorique     String?
  adresse              String?
  telephone            String?
  email                String?
  horaires             String?
  logoUrl              String?
  couleurPrimaire      String   @default("#2f5d3a")
  couleurAccent        String   @default("#b5653f")
  couleurFond          String   @default("#1f3a28")
  couleurHover         String   @default("#c27a52")
  heroTitre            String?
  heroSousTitre        String?
  heroImageUrl         String?
  heroImageAlt         String?
  // { facebook?, instagram?, youtube?, whatsapp?, tiktok? } — URL https uniquement.
  reseauxSociaux       Json?
  inscriptionsOuvertes Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  updatedById          String?
}

// ---------------------------------------------------------------------------
// Archive des données retirées du modèle (district, multi-paroisses).
// Conservées telles quelles (JSON) lors de la simplification mono-paroissiale :
// aucune donnée n'est perdue, aucune n'est plus exploitée par l'application.
// ---------------------------------------------------------------------------

model ArchiveDonnees {
  id        String   @id @default(cuid())
  source    String // Table ou concept d'origine, ex. "District", "Paroisse"
  sourceId  String?
  donnees   Json
  motif     String
  archiveLe DateTime @default(now())

  @@index([source])
}

// ---------------------------------------------------------------------------
// Branche — présentation institutionnelle d'une branche active du groupe.
// Le type (référentiel officiel) reste l'énumération BrancheType.
// ---------------------------------------------------------------------------

model Branche {
  id             String      @id @default(cuid())
  type           BrancheType @unique
  slug           String      @unique
  presentation   String?
  identite       String? // Devise, symboles, couleurs (texte officiel fourni par le groupe)
  objectifs      String?
  pedagogie      String?
  activitesTypes String?
  imageUrl       String?
  imageAlt       String?
  active         Boolean     @default(true) // Branche ouverte dans le groupe
  publiee        Boolean     @default(true) // Visible sur le site public
  ordre          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Équipe / unité au sein d'une branche (sizaine, patrouille, équipe…)
// ---------------------------------------------------------------------------

model Equipe {
  id          String      @id @default(cuid())
  nom         String
  brancheType BrancheType
  description String?
  actif       Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  scouts Scout[]

  @@unique([brancheType, nom])
  @@index([brancheType])
}

// ---------------------------------------------------------------------------
// Utilisateur
// ---------------------------------------------------------------------------

model Utilisateur {
  id                    String          @id @default(cuid())
  nom                   String
  prenom                String
  matricule             String?         @unique // Requis pour chefs/scouts, absent pour parents
  telephone             String?         @unique // Requis pour parents, optionnel pour les autres
  email                 String?         @unique
  password              String
  doitChangerMotDePasse Boolean         @default(false)
  role                  RoleUtilisateur
  fonction              String? // Champ libre pour un rôle sans fonction structurée
  brancheType           BrancheType? // Branche gérée par RESPONSABLE/ADJOINT/ASSISTANT_BRANCHE
  actif                 Boolean         @default(true)
  // Permission explicite de gérer les contenus publics (actualités, galerie,
  // histoire) — toujours vraie de fait pour ADMINISTRATEUR.
  editeurContenu        Boolean         @default(false)

  // Présentation publique (page « Notre équipe ») : jamais affichée sans
  // l'accord explicite de la personne (profilPublic).
  profilPublic     Boolean @default(false)
  fonctionPublique String?
  photoPublique    String?
  biographie       String?
  ordrePublic      Int     @default(0)

  tokenCalendrier String?  @unique // Jeton d'abonnement au flux iCal personnel (généré à la demande)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  liensParent                 LienParentScout[]
  contactsUrgence             ContactUrgence[]
  ficheScout                  Scout?
  activitesCreees             Activite[]              @relation("ActiviteCreePar")
  activitesResponsable        Activite[]              @relation("ActiviteResponsable")
  progressionsValidees        ProgressionScout[]      @relation("ProgressionValidePar")
  joursReunionCrees           JourReunion[]           @relation("JourReunionCreePar")
  presencesReunionMarquees    PresenceReunion[]       @relation("PresenceReunionMarquePar")
  tokensReinitialisation      TokenReinitialisation[]
  sessions                    SessionUtilisateur[]
  programmesCrees             Programme[]             @relation("ProgrammeCreePar")
  autorisationsCampConfirmees AutorisationCamp[]      @relation("AutorisationCampConfirmePar")
  consentementsImageConfirmes Scout[]                 @relation("ScoutConsentementImageConfirmePar")
  consentementsSanteConfirmes Scout[]                 @relation("ScoutConsentementSanteConfirmePar")
  actionsAudit                JournalAudit[]
  cotisationsEnregistrees     Cotisation[]            @relation("CotisationEnregistreePar")
  publications                Publication[]           @relation("PublicationAuteur")
  demandesTraitees            DemandeAdhesion[]       @relation("DemandeTraiteePar")
  mandats                     Mandat[]

  // Unicité « 1 seul CHEF_GROUPE actif » et « 1 seul RESPONSABLE_BRANCHE actif
  // par branche » : index partiels créés en migration (pas de WHERE en DSL).
  @@index([role])
  @@index([brancheType])
}

// ---------------------------------------------------------------------------
// Mandat — historique des responsabilités exercées dans la maîtrise.
// Le rôle courant reste Utilisateur.role ; un mandat est ouvert à chaque
// nomination et clos à chaque changement ou désactivation.
// ---------------------------------------------------------------------------

model Mandat {
  id          String          @id @default(cuid())
  role        RoleUtilisateur
  brancheType BrancheType?
  debutLe     DateTime        @default(now())
  finLe       DateTime?
  auteurId    String?
  motif       String?

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Restrict)

  @@index([utilisateurId, debutLe])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Scout
// ---------------------------------------------------------------------------

model Scout {
  id                  String      @id @default(cuid())
  nom                 String
  prenom              String
  dateNaissance       DateTime
  sexe                Sexe
  brancheType         BrancheType
  matricule           String?     @unique // Optionnel à l'inscription, ajouté plus tard
  actif               Boolean     @default(true)
  photo               String?
  allergies           String? // Champ libre : allergies connues (alimentaires, médicamenteuses…)
  traitementsMedicaux String? // Champ libre : traitements en cours, à connaître en cas d'urgence (camp, activité)

  // Consentement des parents à l'utilisation de la photo/image du scout
  // (publications, communication de la paroisse). Refusé par défaut tant que
  // personne ne l'a explicitement accordé.
  consentementImage        Boolean   @default(false)
  consentementImageDate    DateTime?
  // Provenance de la déclaration, sans présumer l’autorité juridique du compte.
  consentementImageOrigine String?

  // Consentement des parents au traitement des données de santé du scout
  // (allergies, traitements, fiches médicales). Enregistré et journalisé, sans
  // bloquer la saisie : une information médicale manquante au camp serait
  // plus dangereuse qu'une fiche signalée « sans consentement ».
  consentementSante        Boolean   @default(false)
  consentementSanteDate    DateTime?
  consentementSanteOrigine String?

  // Conservation (loi n° 2013-450) : date de désactivation, point de départ
  // du délai avant anonymisation, et date de l'anonymisation effectuée.
  desactiveLe DateTime?
  anonymiseLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Équipe ou unité de la branche (facultative).
  equipeId String?
  equipe   Equipe? @relation(fields: [equipeId], references: [id], onDelete: SetNull)

  // Compte utilisateur optionnel (certains scouts ont un espace personnel)
  utilisateurId String?      @unique
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  // Qui a confirmé le consentement à l'image (parent ou staff)
  consentementImageParId String?
  consentementImagePar   Utilisateur? @relation("ScoutConsentementImageConfirmePar", fields: [consentementImageParId], references: [id], onDelete: SetNull)

  // Qui a confirmé le consentement aux données de santé (parent ou staff)
  consentementSanteParId String?
  consentementSantePar   Utilisateur? @relation("ScoutConsentementSanteConfirmePar", fields: [consentementSanteParId], references: [id], onDelete: SetNull)

  // Relations
  liensParents      LienParentScout[] // Parents avec compte dans l'application
  contactsUrgence   ContactUrgence[] // Contacts d'urgence (avec ou sans compte)
  presences         Presence[]
  presencesReunion  PresenceReunion[]
  progressions      ProgressionScout[]
  documents         Document[]
  autorisationsCamp AutorisationCamp[]
  cotisations       Cotisation[]

  @@index([brancheType])
  @@index([equipeId])
  @@index([actif])
  @@index([photo])
  @@index([desactiveLe])
  @@index([consentementSanteParId])
  @@index([nom, prenom])
}

// ---------------------------------------------------------------------------
// Contact d'urgence d'un scout
// Nom + téléphone à contacter — pas besoin d'avoir un compte dans l'application
// ---------------------------------------------------------------------------

model ContactUrgence {
  id        String  @id @default(cuid())
  nom       String
  prenom    String?
  telephone String
  relation  String? // Ex : Père, Mère, Tuteur, Oncle...
  principal Boolean @default(false) // Contact prioritaire

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  // Lien optionnel si ce contact a aussi un compte dans l'application
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scoutId])
}

// ---------------------------------------------------------------------------
// Lien Parent <-> Scout
// ---------------------------------------------------------------------------

model LienParentScout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  parentId String
  parent   Utilisateur @relation(fields: [parentId], references: [id], onDelete: Cascade)

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  @@unique([parentId, scoutId])
  @@index([parentId])
  @@index([scoutId])
}

// ---------------------------------------------------------------------------
// Activité
// ---------------------------------------------------------------------------

model Activite {
  id                  String         @id @default(cuid())
  titre               String
  description         String?
  dateDebut           DateTime
  dateFin             DateTime?
  lieu                String?
  type                TypeActivite   @default(REUNION)
  brancheType         BrancheType? // Null = activité inter-branches
  statut              StatutActivite @default(PREVUE)
  bilan               String?
  // Une activité n'est jamais publique par défaut : publication explicite,
  // avec un texte destiné au public distinct de la description interne.
  publique            Boolean        @default(false)
  descriptionPublique String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  creePar            String
  creeParUtilisateur Utilisateur @relation("ActiviteCreePar", fields: [creePar], references: [id], onDelete: Restrict)

  responsableId String?
  responsable   Utilisateur? @relation("ActiviteResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  // Relations
  presences         Presence[]
  ligneProgramme    LigneProgramme?
  autorisationsCamp AutorisationCamp[]
  albums            Album[]
  cotisations       Cotisation[]

  @@index([brancheType])
  @@index([dateDebut])
  @@index([creePar])
  @@index([publique, dateDebut])
}

// ---------------------------------------------------------------------------
// Présence
// ---------------------------------------------------------------------------

model Presence {
  id          String   @id @default(cuid())
  present     Boolean  @default(false)
  commentaire String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  activiteId String
  activite   Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  @@unique([scoutId, activiteId])
  @@index([scoutId])
  @@index([activiteId])
}

// ---------------------------------------------------------------------------
// Badge (référentiel pédagogique par branche)
// ---------------------------------------------------------------------------

model Badge {
  id          String      @id @default(cuid())
  nom         String
  description String?
  brancheType BrancheType
  ordre       Int         @default(0) // Ordre dans le parcours de la branche
  icone       String? // URL ou nom d'icône
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  progressions ProgressionScout[]

  @@unique([brancheType, nom])
  @@index([brancheType])
  @@index([ordre])
}

// ---------------------------------------------------------------------------
// Progression Scout (badges validés)
// ---------------------------------------------------------------------------

model ProgressionScout {
  id             String   @id @default(cuid())
  dateValidation DateTime @default(now())
  commentaire    String?
  createdAt      DateTime @default(now())

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  valideParId String
  validePar   Utilisateur @relation("ProgressionValidePar", fields: [valideParId], references: [id], onDelete: Restrict)

  @@unique([scoutId, badgeId])
  @@index([scoutId])
  @@index([badgeId])
  @@index([valideParId])
}

// ---------------------------------------------------------------------------
// Document (pièces justificatives par scout)
// ---------------------------------------------------------------------------

model Document {
  id             String       @id @default(cuid())
  type           TypeDocument
  nomFichier     String
  url            String
  dateUpload     DateTime     @default(now())
  dateExpiration DateTime? // Ex : certificat médical valable 1 an. Null = pas de péremption connue.
  rappelEnvoyeLe DateTime? // Rappel d'expiration envoyé aux parents (une seule fois)
  valide         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  @@index([scoutId])
  @@index([type])
  @@index([valide])
  @@index([dateExpiration])
  @@index([url])
}

// ---------------------------------------------------------------------------
// Jour de réunion
// ---------------------------------------------------------------------------

model JourReunion {
  id           String        @id @default(cuid())
  brancheType  BrancheType? // null = toutes branches
  titre        String?
  dateHeure    DateTime
  dureeMinutes Int?
  lieu         String?
  statut       StatutReunion @default(PLANIFIEE)
  dateReportee DateTime? // nouvelle date si statut = REPORTEE
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creePar            String
  creeParUtilisateur Utilisateur @relation("JourReunionCreePar", fields: [creePar], references: [id], onDelete: Restrict)

  presences PresenceReunion[]

  @@index([brancheType])
  @@index([dateHeure])
  @@index([statut])
  @@index([creePar])
}

// ---------------------------------------------------------------------------
// Présence à une réunion
// ---------------------------------------------------------------------------

model PresenceReunion {
  id        String                @id @default(cuid())
  statut    StatutPresenceReunion @default(ABSENT)
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  jourReunionId String
  jourReunion   JourReunion @relation(fields: [jourReunionId], references: [id], onDelete: Cascade)

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  marqueParId String?
  marquePar   Utilisateur? @relation("PresenceReunionMarquePar", fields: [marqueParId], references: [id], onDelete: SetNull)

  @@unique([jourReunionId, scoutId])
  @@index([jourReunionId])
  @@index([scoutId])
  @@index([marqueParId])
}

// ---------------------------------------------------------------------------
// Token de réinitialisation de mot de passe. Seule l'empreinte SHA-256 du
// jeton envoyé par e-mail est stockée : une fuite de la table ne permet pas
// de réinitialiser un mot de passe.
// ---------------------------------------------------------------------------

model TokenReinitialisation {
  id        String   @id @default(cuid())
  empreinte String   @unique
  expiresAt DateTime
  utilise   Boolean  @default(false)
  createdAt DateTime @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([empreinte])
  @@index([utilisateurId])
}

// Session de connexion (jeton de rafraîchissement). Seule l'empreinte SHA-256
// du jeton est stockée : une fuite de la table ne permet pas d'ouvrir de
// session. Rotation à chaque rafraîchissement ; l'empreinte précédente reste
// acceptée quelques secondes (ancienneValideJusqua) pour absorber les
// requêtes parallèles d'un même navigateur sans le déconnecter.
model SessionUtilisateur {
  id                   String    @id @default(cuid())
  empreinteJeton       String    @unique
  ancienneEmpreinte    String?   @unique
  ancienneValideJusqua DateTime?
  expireLe             DateTime
  revoqueeLe           DateTime?
  agentUtilisateur     String? // User-Agent tronqué, pour l'audit des sessions
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@index([expireLe])
}

// ---------------------------------------------------------------------------
// Configuration des jours de réunion par branche (permanente, toutes années)
// ---------------------------------------------------------------------------

model ConfigReunionBranche {
  id           String      @id @default(cuid())
  brancheType  BrancheType @unique
  jourSemaine  Int // 0=dim, 1=lun, 2=mar, 3=mer, 4=jeu, 5=ven, 6=sam
  heureDebut   String // "09:00"
  dureeMinutes Int         @default(90)
  lieu         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Programme d'activités (groupe ou branche, sur une période donnée)
// brancheType = null : programme du groupe. brancheType défini : programme propre à la branche.
// ---------------------------------------------------------------------------

model Programme {
  id           String       @id @default(cuid())
  titre        String
  description  String?
  periodeDebut DateTime
  periodeFin   DateTime
  brancheType  BrancheType? // null = programme du groupe
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  creePar            String
  creeParUtilisateur Utilisateur @relation("ProgrammeCreePar", fields: [creePar], references: [id], onDelete: Restrict)

  lignes LigneProgramme[]

  @@index([brancheType])
  @@index([periodeDebut])
  @@index([creePar])
}

// ---------------------------------------------------------------------------
// Ligne de programme (thème/étape planifiée, éventuellement réalisée via une Activité)
// ---------------------------------------------------------------------------

model LigneProgramme {
  id         String    @id @default(cuid())
  theme      String
  objectif   String?
  datePrevue DateTime?
  ordre      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  // Lien optionnel vers l'Activité qui réalise concrètement cette ligne
  activiteId String?   @unique
  activite   Activite? @relation(fields: [activiteId], references: [id], onDelete: SetNull)

  @@index([programmeId])
}

// ---------------------------------------------------------------------------
// Autorisation de camp — signature/confirmation du parent propre à un camp donné
// Distincte du Document permanent (fiche médicale) : ici on trace le consentement
// pour CETTE activité précise (fiche médicale à jour + autorisation parentale).
// ---------------------------------------------------------------------------

enum TypeAutorisationCamp {
  FICHE_MEDICALE
  AUTORISATION_PARENTALE
}

model AutorisationCamp {
  id                 String               @id @default(cuid())
  type               TypeAutorisationCamp
  documentNomFichier String? // Renseigné si confirmé par upload d'un document signé
  documentUrl        String?
  confirmeLe         DateTime? // null = pas encore confirmé
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  activiteId String
  activite   Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  confirmeParId String?
  confirmePar   Utilisateur? @relation("AutorisationCampConfirmePar", fields: [confirmeParId], references: [id], onDelete: SetNull)

  @@unique([activiteId, scoutId, type])
  @@index([activiteId])
  @@index([scoutId])
  @@index([confirmeParId])
  @@index([documentUrl])
}

// ---------------------------------------------------------------------------
// Journal d'audit — trace les actions sensibles (gestion des comptes, des
// scouts, des documents, des contenus…) pour la responsabilité et la
// conformité. L'acteur est conservé même si son compte est supprimé
// (onDelete: SetNull) : la trace doit survivre à celui qui l'a effectuée.
// ---------------------------------------------------------------------------

model JournalAudit {
  id        String   @id @default(cuid())
  action    String // Ex : "UTILISATEUR_ROLE_MODIFIE", "SCOUT_SUPPRIME"…
  entite    String // Ex : "Utilisateur", "Scout", "Document"…
  entiteId  String?
  details   Json?
  createdAt DateTime @default(now())

  acteurId String?
  acteur   Utilisateur? @relation(fields: [acteurId], references: [id], onDelete: SetNull)

  @@index([entite, entiteId])
  @@index([acteurId])
  @@index([action])
  @@index([createdAt]) // Purge selon la durée de conservation (RETENTION_AUDIT_JOURS)
}

// ---------------------------------------------------------------------------
// Cotisation — suivi des paiements d'adhésion et autres frais (camp…) par
// scout et par année scolaire. Montants en FCFA (entiers, pas de décimales).
// ---------------------------------------------------------------------------

model Cotisation {
  id            String           @id @default(cuid())
  type          TypeCotisation   @default(ADHESION_ANNUELLE)
  libelle       String? // Précision libre, surtout utile pour le type AUTRE
  montant       Int // Montant dû, en FCFA
  montantPaye   Int              @default(0) // Toujours cohérent avec statut : 0 (EN_ATTENTE), = montant (PAYEE), entre les deux (PARTIELLEMENT_PAYEE)
  anneeScolaire String // Ex : "2026-2027"
  statut        StatutCotisation @default(EN_ATTENTE)
  datePaiement  DateTime?
  modePaiement  String? // Ex : Espèces, Mobile Money, Virement… champ libre
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Restrict (pas Cascade) : un scout n'est jamais supprimé physiquement dans
  // l'application (désactivé, pour conserver l'historique) — et si une
  // suppression manuelle était un jour nécessaire, elle ne doit jamais effacer
  // silencieusement un historique de paiement.
  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Restrict)

  // Cotisation d'activité (camp, sortie…) : facultatif.
  activiteId String?
  activite   Activite? @relation(fields: [activiteId], references: [id], onDelete: SetNull)

  enregistreParId String?
  enregistrePar   Utilisateur? @relation("CotisationEnregistreePar", fields: [enregistreParId], references: [id], onDelete: SetNull)

  @@index([scoutId])
  @@index([statut])
  @@index([anneeScolaire])
  @@index([enregistreParId])
  @@index([activiteId])
}

// Barème configurable des cotisations : aucun tarif n'est codé en dur. Une
// ligne sans branche s'applique à toutes les branches.
model BaremeCotisation {
  id            String         @id @default(cuid())
  anneeScolaire String
  type          TypeCotisation
  brancheType   BrancheType?
  libelle       String?
  montant       Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([anneeScolaire])
}

// ---------------------------------------------------------------------------
// Contenus publics : actualités (CMS), galerie, histoire, demandes d'adhésion
// ---------------------------------------------------------------------------

model CategoriePublication {
  id        String   @id @default(cuid())
  nom       String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  publications Publication[]
}

model Publication {
  id              String            @id @default(cuid())
  titre           String
  slug            String            @unique
  resume          String?
  // Contenu en texte structuré léger (paragraphes, titres « ## », listes « - »),
  // rendu côté frontend sans HTML brut : aucune injection possible.
  contenu         String
  imageCouverture String?
  imageAlt        String?
  statut          StatutPublication @default(BROUILLON)
  datePublication DateTime?
  seoTitre        String?
  seoDescription  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  categorieId String?
  categorie   CategoriePublication? @relation(fields: [categorieId], references: [id], onDelete: SetNull)

  auteurId String?
  auteur   Utilisateur? @relation("PublicationAuteur", fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([statut, datePublication])
  @@index([categorieId])
}

model Album {
  id            String    @id @default(cuid())
  titre         String
  slug          String    @unique
  description   String?
  categorie     String?
  dateEvenement DateTime?
  publie        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  activiteId String?
  activite   Activite? @relation(fields: [activiteId], references: [id], onDelete: SetNull)

  medias Media[]

  @@index([publie, dateEvenement])
}

model Media {
  id                  String   @id @default(cuid())
  url                 String
  legende             String?
  texteAlt            String?
  ordre               Int      @default(0)
  // Une photo n'est publique que si elle est explicitement publiée ET, quand
  // elle montre des mineurs, que le consentement à l'image a été vérifié.
  publie              Boolean  @default(false)
  contientMineurs     Boolean  @default(true)
  consentementVerifie Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, ordre])
  @@index([url])
}

model EvenementHistorique {
  id               String                     @id @default(cuid())
  annee            Int
  date             DateTime?
  titre            String
  description      String?
  type             TypeEvenementHistorique    @default(ETAPE)
  auteurTemoignage String?
  imageUrl         String?
  imageAlt         String?
  documentUrl      String?
  source           String?
  statutValidation StatutValidationHistorique @default(A_VERIFIER)
  publie           Boolean                    @default(false)
  ordre            Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([publie, annee])
}

model DemandeAdhesion {
  id                 String        @id @default(cuid())
  type               TypeDemande   @default(INSCRIPTION_JEUNE)
  nomContact         String
  prenomContact      String
  telephone          String
  email              String?
  nomJeune           String?
  prenomJeune        String?
  dateNaissanceJeune DateTime?
  brancheSouhaitee   BrancheType?
  message            String?
  consentementLe     DateTime
  statut             StatutDemande @default(NOUVELLE)
  notesInternes      String?
  traiteeLe          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  traiteeParId String?
  traiteePar   Utilisateur? @relation("DemandeTraiteePar", fields: [traiteeParId], references: [id], onDelete: SetNull)

  @@index([statut, createdAt])
}
