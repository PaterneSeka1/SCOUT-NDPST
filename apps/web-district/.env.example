# Configuration de l'application district (Next.js) : plusieurs paroisses et
# console de l'administrateur plateforme. Copier en .env et remplir. Aucun
# secret ni accès à la base : /api/* est relayé vers l'API NestJS de
# l'installation district.

# URL de l'API de l'installation district, joignable depuis le serveur Next.js
# (réseau interne, jamais exposée au navigateur). Lue AU MOMENT DU BUILD :
# recompiler après l'avoir modifiée.
API_URL_INTERNE="http://127.0.0.1:4000"

# URL publique de l'application district.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Domaine public des fichiers (Cloudflare R2) de l'installation district,
# OBLIGATOIRE en production : même valeur que STORAGE_PUBLIC_URL_BASE dans le
# .env de son API. Autorisé dans la politique de sécurité des contenus (CSP).
# Lue AU MOMENT DU BUILD : recompiler après l’avoir modifiée.
STORAGE_PUBLIC_URL_BASE=""

# Installations autonomes que l'administrateur plateforme gère aussi depuis
# cette console (liste JSON, une seule ligne). Chacune doit faire confiance à
# la clé publique du district (ADMIN_EMETTEUR_CONFIANCE et
# ADMIN_CLE_PUBLIQUE_FICHIER dans le .env de son API).
# INSTALLATIONS_GEREES='[{"id":"paroisse-wiradjuri","nom":"Paroisse Wiradjuri","api":"http://127.0.0.1:4000"}]'
INSTALLATIONS_GEREES=""
