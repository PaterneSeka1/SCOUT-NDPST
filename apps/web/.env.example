# Configuration du frontend (Next.js). Copier en .env et remplir.
# Le frontend ne détient aucun secret ni accès à la base : il relaie /api/*
# vers l'API NestJS et affiche les pages.

# URL de l'API joignable depuis le serveur Next.js (réseau interne, jamais
# exposée au navigateur). Lue AU MOMENT DU BUILD : recompiler après l’avoir
# modifiée.
API_URL_INTERNE="http://127.0.0.1:4000"

# URL publique du site (métadonnées Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Domaine public des fichiers (Cloudflare R2), OBLIGATOIRE en production :
# même valeur que STORAGE_PUBLIC_URL_BASE dans apps/api/.env. Autorisé dans la
# politique de sécurité des contenus (CSP) pour afficher logos et images.
# Lue AU MOMENT DU BUILD : recompiler après l’avoir modifiée.
STORAGE_PUBLIC_URL_BASE=""
