# Variables pour docker-compose.prod.yml — copier en ".env.prod" sur le VPS
# (jamais commité) et remplir avec de vraies valeurs.
#
# Ce fichier ne concerne que la base de données (le seul service Docker de ce
# setup) : l'app tourne directement sur l'hôte via pm2, configurée par
# my-app/.env (voir my-app/.env.example) — pas ici.

POSTGRES_PASSWORD=choisissez-un-mot-de-passe-long-et-aleatoire
