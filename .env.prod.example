# Variables pour docker-compose.prod.yml — copier en ".env.prod" sur le VPS
# (jamais commité) et remplir avec de vraies valeurs.

# URL publique complète de l'appli (avec schéma http:// ou https://).
# - Avec nom de domaine (recommandé en production) : https://suivi.mondomaine.ci
#   — le DNS du sous-domaine doit pointer vers l'IP publique du VPS, et un
#   vhost nginx + certificat Certbot doit exister en amont (voir README).
# - Sans domaine (test rapide) : http://<ip-publique-du-vps>:8080
PUBLIC_URL=https://suivi.mondomaine.ci

POSTGRES_PASSWORD=choisissez-un-mot-de-passe-long-et-aleatoire
NEXTAUTH_SECRET=choisissez-un-secret-different-et-tout-aussi-long
CRON_SECRET=choisissez-encore-un-secret-different

# Email (optionnel — si absent, les liens sont tracés dans les logs du
# conteneur au lieu d'être envoyés)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
