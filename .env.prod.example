# Variables de l'installation, lues par deploy-ovh.sh et docker-compose.prod.yml.
# Copier en « .env.prod » à la racine du clone sur le VPS (jamais commité) et
# remplir avec de vraies valeurs.
#
# La base de données est le seul service Docker : l'API et le frontend tournent
# directement sur l'hôte via pm2, configurés par apps/api/.env et
# apps/web-*/.env — pas ici.

# Installation déployée par ce clone : « paroisse » ou « district ».
INSTALLATION=paroisse

POSTGRES_PASSWORD=choisissez-un-mot-de-passe-long-et-aleatoire

# Installation district uniquement (clone séparé, par exemple /srv/scout-district) :
# conteneur, port et volume distincts de ceux de la paroisse, sur le même VPS.
# COMPOSE_PROJET=scout-district
# CONTENEUR_DB=scout_district_db
# PORT_DB=5436
