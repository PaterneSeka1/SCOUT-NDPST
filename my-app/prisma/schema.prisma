// Schéma Prisma — Application SCOUT ASCCI (Côte d'Ivoire)
// Suivi pédagogique du mouvement scout catholique

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum BrancheType {
  OISILLONS
  LOUVETEAUX
  ECLAIREURS
  CHEMINOTS
  COMPAGNONS
}

enum RoleUtilisateur {
  ADMIN_PLATEFORME // Rôle global, transverse à toutes les paroisses (paroisseId = null)
  CHEF_GROUPE
  ADJOINT_GROUPE
  ASSISTANT_GROUPE
  RESPONSABLE_BRANCHE
  ADJOINT_BRANCHE
  ASSISTANT_BRANCHE
  PARENT
  SCOUT
}

enum RolePosteGroupe {
  CHEF_GROUPE
  ADJOINT_GROUPE
  ASSISTANT_GROUPE
}

enum RolePosteBranche {
  RESPONSABLE
  ADJOINT
  ASSISTANT
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum TypeActivite {
  REUNION
  SORTIE
  CAMP
  SERVICE
  CELEBRATION
  FORMATION
  AUTRE
}

enum TypeDocument {
  AUTORISATION_PARENTALE
  CERTIFICAT_MEDICAL
  PHOTO_IDENTITE
  AUTRE
}

enum StatutReunion {
  PLANIFIEE
  REPORTEE
  ANNULEE
  TERMINEE
}

enum StatutPresenceReunion {
  PRESENT
  ABSENT
  EXCUSE
}

enum TypeCotisation {
  ADHESION_ANNUELLE
  CAMP
  AUTRE
}

enum StatutCotisation {
  EN_ATTENTE
  PAYEE
  EXONEREE
}

// ---------------------------------------------------------------------------
// Paroisse
// ---------------------------------------------------------------------------

model Paroisse {
  id        String   @id @default(cuid())
  nom       String
  ville     String
  diocese   String
  ocean     String?
  doyenne   String?
  adresse   String?
  telephone String?
  email     String?  @unique
  logo      String? // URL ou chemin vers le logo
  actif     Boolean  @default(true) // Paroisse désactivée = accès bloqué pour ses utilisateurs

  // Identité visuelle propre à la paroisse, visible par ses utilisateurs connectés.
  // Null = pas personnalisée, on retombe sur les valeurs de ConfigurationPlateforme.
  couleurPrimaire String?
  couleurAccent   String?
  couleurFond     String?
  couleurHover    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  utilisateurs   Utilisateur[]
  postesGroupe   PosteGroupe[]
  postesBranche  PosteBranche[]
  scouts         Scout[]
  activites      Activite[]
  joursReunion   JourReunion[]
  configsReunion ConfigReunionBranche[]
  programmes     Programme[]
  journalAudit   JournalAudit[]
  cotisations    Cotisation[]

  @@index([ville])
  @@index([diocese])
}

// ---------------------------------------------------------------------------
// Configuration plateforme — identité visuelle commune à toutes les paroisses
// (page d'accueil et de connexion, avant qu'on sache à quelle paroisse un
// visiteur appartient). Ligne unique (id fixe "platform"), gérée exclusivement
// par ADMIN_PLATEFORME. Remplace l'ancien fichier config/site.json.
// ---------------------------------------------------------------------------

model ConfigurationPlateforme {
  id              String   @id @default("platform")
  nomSite         String   @default("SCOUT ASCCI")
  sousTitreSite   String   @default("Côte d'Ivoire")
  logoUrl         String?
  couleurPrimaire String   @default("#1a4731")
  couleurAccent   String   @default("#27ae60")
  couleurFond     String   @default("#0f2418")
  couleurHover    String   @default("#27ae60")
  heroBadge       String?
  heroTitre       String?
  heroSousTitre   String?
  heroImageUrl    String?
  heroImageAlt    String?
  stats           Json?
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Utilisateur
// ---------------------------------------------------------------------------

model Utilisateur {
  id        String          @id @default(cuid())
  nom       String
  prenom    String
  matricule String?         @unique // Requis pour chefs/scouts, absent pour parents
  telephone String?         @unique // Requis pour parents, optionnel pour les autres
  email     String?         @unique
  password  String
  role      RoleUtilisateur
  actif     Boolean         @default(true)
  tokenCalendrier String?   @unique // Jeton d'abonnement au flux iCal personnel (généré à la demande)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Clé étrangère — nulle uniquement pour ADMIN_PLATEFORME (rôle transverse, non
  // rattaché à une paroisse). Contrainte CHECK ajoutée en migration pour garantir
  // cette cohérence au niveau base (voir migration correspondante).
  paroisseId String?
  paroisse   Paroisse? @relation(fields: [paroisseId], references: [id], onDelete: Restrict)

  // Relations
  posteGroupe                 PosteGroupe?
  postesBranche               PosteBranche[]
  liensParent                 LienParentScout[]
  contactsUrgence             ContactUrgence[] // Contacts d'urgence liés à ce compte
  ficheScout                  Scout? // Fiche Scout liée (si rôle SCOUT)
  activitesCreees             Activite[]              @relation("ActiviteCreePar")
  progressionsValidees        ProgressionScout[]      @relation("ProgressionValidePar")
  joursReunionCrees           JourReunion[]           @relation("JourReunionCreePar")
  presencesReunionMarquees    PresenceReunion[]       @relation("PresenceReunionMarquePar")
  tokensReinitialisation      TokenReinitialisation[]
  programmesCrees             Programme[]             @relation("ProgrammeCreePar")
  autorisationsCampConfirmees AutorisationCamp[]      @relation("AutorisationCampConfirmePar")
  consentementsImageConfirmes Scout[]                 @relation("ScoutConsentementImageConfirmePar")
  actionsAudit                JournalAudit[]
  cotisationsEnregistrees     Cotisation[]            @relation("CotisationEnregistreePar")

  @@index([matricule])
  @@index([telephone])
  @@index([paroisseId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Poste Groupe (équipe de groupe de la paroisse)
// Un seul CHEF_GROUPE et un seul ADJOINT_GROUPE par paroisse
// ---------------------------------------------------------------------------

model PosteGroupe {
  id        String          @id @default(cuid())
  role      RolePosteGroupe
  fonction  String? // Champ libre pour ASSISTANT_GROUPE (ex. Logistique, Secrétariat)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Clés étrangères
  utilisateurId String      @unique
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Restrict)

  // Règle : 1 seul CHEF_GROUPE et 1 seul ADJOINT_GROUPE par paroisse, N ASSISTANT_GROUPE possible.
  // La contrainte d'unicité pour CHEF et ADJOINT est gérée en logique applicative (service layer).
  // En migration SQL, un partial unique index peut être ajouté manuellement :
  //   CREATE UNIQUE INDEX ON "PosteGroupe"("paroisseId", role) WHERE role != 'ASSISTANT_GROUPE';
  @@index([paroisseId])
  @@index([role])
}

// ---------------------------------------------------------------------------
// Poste Branche (responsables de chaque branche)
// Un seul RESPONSABLE et un seul ADJOINT par (brancheType, paroisse)
// ---------------------------------------------------------------------------

model PosteBranche {
  id          String           @id @default(cuid())
  brancheType BrancheType
  role        RolePosteBranche
  fonction    String? // Champ libre pour ASSISTANT
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Clés étrangères
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Restrict)

  // Règle : 1 seul RESPONSABLE et 1 seul ADJOINT par (brancheType, paroisse), N ASSISTANT possible.
  // Contrainte RESPONSABLE/ADJOINT gérée en logique applicative.
  // En migration SQL, partial unique index recommandé :
  //   CREATE UNIQUE INDEX ON "PosteBranche"("paroisseId", "brancheType", role) WHERE role != 'ASSISTANT';
  @@index([paroisseId])
  @@index([brancheType])
  @@index([utilisateurId])
}

// ---------------------------------------------------------------------------
// Scout
// ---------------------------------------------------------------------------

model Scout {
  id                  String      @id @default(cuid())
  nom                 String
  prenom              String
  dateNaissance       DateTime
  sexe                Sexe
  brancheType         BrancheType
  matricule           String?     @unique // Optionnel à l'inscription, ajouté plus tard
  actif               Boolean     @default(true)
  photo               String?
  allergies           String? // Champ libre : allergies connues (alimentaires, médicamenteuses…)
  traitementsMedicaux String? // Champ libre : traitements en cours, à connaître en cas d'urgence (camp, activité)

  // Consentement des parents à l'utilisation de la photo/image du scout
  // (publications, communication de la paroisse). Refusé par défaut tant que
  // personne ne l'a explicitement accordé.
  consentementImage     Boolean   @default(false)
  consentementImageDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Clé étrangère
  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Restrict)

  // Compte utilisateur optionnel (certains scouts ont un espace personnel)
  utilisateurId String?      @unique
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  // Qui a confirmé le consentement à l'image (parent ou staff)
  consentementImageParId String?
  consentementImagePar   Utilisateur? @relation("ScoutConsentementImageConfirmePar", fields: [consentementImageParId], references: [id], onDelete: SetNull)

  // Relations
  liensParents      LienParentScout[] // Parents avec compte dans l'application
  contactsUrgence   ContactUrgence[] // Contacts d'urgence (avec ou sans compte)
  presences         Presence[]
  presencesReunion  PresenceReunion[]
  progressions      ProgressionScout[]
  documents         Document[]
  autorisationsCamp AutorisationCamp[]
  cotisations       Cotisation[]

  @@index([paroisseId])
  @@index([brancheType])
  @@index([actif])
}

// ---------------------------------------------------------------------------
// Contact d'urgence d'un scout
// Nom + téléphone à contacter — pas besoin d'avoir un compte dans l'application
// ---------------------------------------------------------------------------

model ContactUrgence {
  id        String  @id @default(cuid())
  nom       String
  prenom    String?
  telephone String
  relation  String? // Ex : Père, Mère, Tuteur, Oncle...
  principal Boolean @default(false) // Contact prioritaire

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  // Lien optionnel si ce contact a aussi un compte dans l'application
  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scoutId])
}

// ---------------------------------------------------------------------------
// Lien Parent <-> Scout
// ---------------------------------------------------------------------------

model LienParentScout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  parentId String
  parent   Utilisateur @relation(fields: [parentId], references: [id], onDelete: Cascade)

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  @@unique([parentId, scoutId])
  @@index([parentId])
  @@index([scoutId])
}

// ---------------------------------------------------------------------------
// Activité
// ---------------------------------------------------------------------------

model Activite {
  id          String       @id @default(cuid())
  titre       String
  description String?
  dateDebut   DateTime
  dateFin     DateTime?
  lieu        String?
  type        TypeActivite @default(REUNION)
  brancheType BrancheType? // Null = activité inter-branches
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Clés étrangères
  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Restrict)

  creePar            String
  creeParUtilisateur Utilisateur @relation("ActiviteCreePar", fields: [creePar], references: [id], onDelete: Restrict)

  // Relations
  presences         Presence[]
  ligneProgramme    LigneProgramme?
  autorisationsCamp AutorisationCamp[]

  @@index([paroisseId])
  @@index([brancheType])
  @@index([dateDebut])
}

// ---------------------------------------------------------------------------
// Présence
// ---------------------------------------------------------------------------

model Presence {
  id          String   @id @default(cuid())
  present     Boolean  @default(false)
  commentaire String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  activiteId String
  activite   Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  @@unique([scoutId, activiteId])
  @@index([scoutId])
  @@index([activiteId])
}

// ---------------------------------------------------------------------------
// Badge (référentiel pédagogique par branche)
// ---------------------------------------------------------------------------

model Badge {
  id          String      @id @default(cuid())
  nom         String
  description String?
  brancheType BrancheType
  ordre       Int         @default(0) // Ordre dans le parcours de la branche
  icone       String? // URL ou nom d'icône
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  progressions ProgressionScout[]

  @@unique([brancheType, nom])
  @@index([brancheType])
  @@index([ordre])
}

// ---------------------------------------------------------------------------
// Progression Scout (badges validés)
// ---------------------------------------------------------------------------

model ProgressionScout {
  id             String   @id @default(cuid())
  dateValidation DateTime @default(now())
  commentaire    String?
  createdAt      DateTime @default(now())

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  valideParId String
  validePar   Utilisateur @relation("ProgressionValidePar", fields: [valideParId], references: [id], onDelete: Restrict)

  @@unique([scoutId, badgeId])
  @@index([scoutId])
  @@index([badgeId])
}

// ---------------------------------------------------------------------------
// Document (pièces justificatives par scout)
// ---------------------------------------------------------------------------

model Document {
  id             String       @id @default(cuid())
  type           TypeDocument
  nomFichier     String
  url            String
  dateUpload     DateTime     @default(now())
  dateExpiration DateTime? // Ex : certificat médical valable 1 an. Null = pas de péremption connue.
  valide         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  @@index([scoutId])
  @@index([type])
  @@index([valide])
  @@index([dateExpiration])
}

// ---------------------------------------------------------------------------
// Jour de réunion
// ---------------------------------------------------------------------------

model JourReunion {
  id           String        @id @default(cuid())
  brancheType  BrancheType? // null = toutes branches
  titre        String?
  dateHeure    DateTime
  dureeMinutes Int?
  lieu         String?
  statut       StatutReunion @default(PLANIFIEE)
  dateReportee DateTime? // nouvelle date si statut = REPORTEE
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Restrict)

  creePar            String
  creeParUtilisateur Utilisateur @relation("JourReunionCreePar", fields: [creePar], references: [id], onDelete: Restrict)

  presences PresenceReunion[]

  @@index([paroisseId])
  @@index([brancheType])
  @@index([dateHeure])
  @@index([statut])
}

// ---------------------------------------------------------------------------
// Présence à une réunion
// ---------------------------------------------------------------------------

model PresenceReunion {
  id        String                @id @default(cuid())
  statut    StatutPresenceReunion @default(ABSENT)
  note      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  jourReunionId String
  jourReunion   JourReunion @relation(fields: [jourReunionId], references: [id], onDelete: Cascade)

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  marqueParId String?
  marquePar   Utilisateur? @relation("PresenceReunionMarquePar", fields: [marqueParId], references: [id], onDelete: SetNull)

  @@unique([jourReunionId, scoutId])
  @@index([jourReunionId])
  @@index([scoutId])
}

// ---------------------------------------------------------------------------
// Token de réinitialisation de mot de passe
// ---------------------------------------------------------------------------

model TokenReinitialisation {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  utilise   Boolean  @default(false)
  createdAt DateTime @default(now())

  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([utilisateurId])
}

// ---------------------------------------------------------------------------
// Configuration des jours de réunion par branche (permanente, toutes années)
// ---------------------------------------------------------------------------

model ConfigReunionBranche {
  id           String      @id @default(cuid())
  brancheType  BrancheType
  jourSemaine  Int // 0=dim, 1=lun, 2=mar, 3=mer, 4=jeu, 5=ven, 6=sam
  heureDebut   String // "09:00"
  dureeMinutes Int         @default(90)
  lieu         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Cascade)

  @@unique([paroisseId, brancheType])
  @@index([paroisseId])
}

// ---------------------------------------------------------------------------
// Programme d'activités (groupe ou branche, sur une période donnée)
// brancheType = null : programme du groupe. brancheType défini : programme propre à la branche.
// ---------------------------------------------------------------------------

model Programme {
  id           String       @id @default(cuid())
  titre        String
  description  String?
  periodeDebut DateTime
  periodeFin   DateTime
  brancheType  BrancheType? // null = programme du groupe
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Restrict)

  creePar            String
  creeParUtilisateur Utilisateur @relation("ProgrammeCreePar", fields: [creePar], references: [id], onDelete: Restrict)

  lignes LigneProgramme[]

  @@index([paroisseId])
  @@index([brancheType])
  @@index([periodeDebut])
}

// ---------------------------------------------------------------------------
// Ligne de programme (thème/étape planifiée, éventuellement réalisée via une Activité)
// ---------------------------------------------------------------------------

model LigneProgramme {
  id         String    @id @default(cuid())
  theme      String
  objectif   String?
  datePrevue DateTime?
  ordre      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  // Lien optionnel vers l'Activité qui réalise concrètement cette ligne
  activiteId String?   @unique
  activite   Activite? @relation(fields: [activiteId], references: [id], onDelete: SetNull)

  @@index([programmeId])
}

// ---------------------------------------------------------------------------
// Autorisation de camp — signature/confirmation du parent propre à un camp donné
// Distincte du Document permanent (fiche médicale) : ici on trace le consentement
// pour CETTE activité précise (fiche médicale à jour + autorisation parentale).
// ---------------------------------------------------------------------------

enum TypeAutorisationCamp {
  FICHE_MEDICALE
  AUTORISATION_PARENTALE
}

model AutorisationCamp {
  id                 String               @id @default(cuid())
  type               TypeAutorisationCamp
  documentNomFichier String? // Renseigné si confirmé par upload d'un document signé
  documentUrl        String?
  confirmeLe         DateTime? // null = pas encore confirmé
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  activiteId String
  activite   Activite @relation(fields: [activiteId], references: [id], onDelete: Cascade)

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  confirmeParId String?
  confirmePar   Utilisateur? @relation("AutorisationCampConfirmePar", fields: [confirmeParId], references: [id], onDelete: SetNull)

  @@unique([activiteId, scoutId, type])
  @@index([activiteId])
  @@index([scoutId])
}

// ---------------------------------------------------------------------------
// Journal d'audit — trace les actions sensibles (gestion des comptes, des
// scouts, des documents…) pour la responsabilité et la conformité. L'acteur
// est conservé même si son compte est supprimé (onDelete: SetNull) : la trace
// de l'action doit survivre à la suppression de celui qui l'a effectuée.
// ---------------------------------------------------------------------------

model JournalAudit {
  id        String   @id @default(cuid())
  action    String // Ex : "UTILISATEUR_ROLE_MODIFIE", "SCOUT_SUPPRIME"…
  entite    String // Ex : "Utilisateur", "Scout", "Document"…
  entiteId  String?
  details   Json?
  createdAt DateTime @default(now())

  // Nulle pour les actions de portée plateforme (gestion des paroisses, branding
  // commun...) qui n'ont pas de paroisse naturelle à qui être rattachées.
  paroisseId String?
  paroisse   Paroisse? @relation(fields: [paroisseId], references: [id], onDelete: Cascade)

  acteurId String?
  acteur   Utilisateur? @relation(fields: [acteurId], references: [id], onDelete: SetNull)

  @@index([paroisseId, createdAt])
  @@index([entite, entiteId])
  @@index([acteurId])
}

// ---------------------------------------------------------------------------
// Cotisation — suivi des paiements d'adhésion et autres frais (camp…) par
// scout et par année scolaire. Montants en FCFA (entiers, pas de décimales).
// ---------------------------------------------------------------------------

model Cotisation {
  id            String           @id @default(cuid())
  type          TypeCotisation   @default(ADHESION_ANNUELLE)
  libelle       String? // Précision libre, surtout utile pour le type AUTRE
  montant       Int // Montant dû, en FCFA
  anneeScolaire String // Ex : "2026-2027"
  statut        StatutCotisation @default(EN_ATTENTE)
  datePaiement  DateTime?
  modePaiement  String? // Ex : Espèces, Mobile Money, Virement… champ libre
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  scoutId String
  scout   Scout  @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  paroisseId String
  paroisse   Paroisse @relation(fields: [paroisseId], references: [id], onDelete: Cascade)

  enregistreParId String?
  enregistrePar   Utilisateur? @relation("CotisationEnregistreePar", fields: [enregistreParId], references: [id], onDelete: SetNull)

  @@index([paroisseId])
  @@index([scoutId])
  @@index([statut])
  @@index([anneeScolaire])
}
