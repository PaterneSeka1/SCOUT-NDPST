DATABASE_URL="postgresql://scout:scout_password@localhost:5434/scout_db"
NEXTAUTH_SECRET="votre-secret-nextauth-ici"
NEXTAUTH_URL="http://localhost:3000"

# Email (optionnel — si absent, les liens sont affichés dans la console en mode dev)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASS="votre-mot-de-passe-smtp"
SMTP_FROM="noreply@scout-ascci.ci"

# Secret partagé pour les endpoints de tâches planifiées (ex : GET /api/cron/rappels-documents,
# à appeler chaque semaine avec l'en-tête "x-cron-secret"). À configurer côté
# ordonnanceur externe (cron serveur, Vercel Cron…) — cette app n'exécute pas
# de planification interne.
CRON_SECRET="choisissez-un-secret-long-et-aleatoire"

# Stockage des fichiers (optionnel). Par défaut (aucune variable ci-dessous
# définie), les fichiers sont écrits sur le disque local — adapté à un
# hébergement avec disque persistant (VPS/Docker avec volume monté). Dès que
# STORAGE_S3_BUCKET est renseigné, le stockage bascule automatiquement vers un
# service compatible S3 : AWS S3, mais aussi DigitalOcean Spaces, Backblaze B2,
# Scaleway Object Storage, MinIO auto-hébergé… (laisser STORAGE_S3_ENDPOINT
# vide pour AWS S3 lui-même).
# STORAGE_S3_BUCKET="mon-bucket"
# STORAGE_S3_REGION="fra1"
# STORAGE_S3_ENDPOINT="https://fra1.digitaloceanspaces.com"
# STORAGE_S3_FORCE_PATH_STYLE="false"
# STORAGE_S3_ACCESS_KEY_ID="..."
# STORAGE_S3_SECRET_ACCESS_KEY="..."
# URL publique de base pour les fichiers publics (logo, image d'accueil) —
# ex : le domaine du CDN devant le bucket, ou l'URL publique du bucket lui-même.
# STORAGE_PUBLIC_URL_BASE="https://mon-bucket.fra1.cdn.digitaloceanspaces.com"
